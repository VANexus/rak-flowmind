# ============================================================
# FlowMind RAK 环境变量模板（复制到工作区根 .env 后填写；.env 已 gitignored）
#
# 命名规范：按「功能域」统一前缀，与任何特定大模型供应商解耦。
#   - LLM 域（编排/翻译/提示词反推/长尾词）  : AI_LLM_*
#   - 生图域（商品主图/营销图）              : AI_IMAGE_*
#   - 语音域（ASR/TTS/OCR）                  : AI_SPEECH_*
#   - 趋势数据域（TikTok/Instagram 榜单）    : AI_TRENDS_*
# 每个域可独立 key + url；某功能需要专属 key 时加细分项覆盖，
# 未细分则统一用域级 key。密钥只放 .env，绝不进 toml / commit。
# ============================================================

# ── LLM 域（编排/翻译/提示词反推；Anthropic 兼容协议）──
AI_LLM_PROTOCOL=anthropic
AI_LLM_API_KEY=your_llm_api_key_here
AI_LLM_BASE_URL=https://api.longcat.chat/anthropic
AI_LLM_MODEL=LongCat-2.0

# ── 生图域（营销生图/SKU 图；OpenAI 兼容 /v1/images/generations）──
AI_IMAGE_API_KEY=your_image_api_key_here
AI_IMAGE_API_URL=https://api.ciyuansky.com/v1/images/generations

# ── 语音域（ASR: Paraformer 录音识别 / TTS+声音克隆: CosyVoice / OCR）──
AI_SPEECH_API_KEY=your_speech_api_key_here
AI_SPEECH_API_URL=

# ── 趋势数据域（TikTok/Instagram 热门榜单，docs.tikhub.io）──
# 获取：注册 tikhub.io → 用户中心创建 API Token
# 域名：大陆用加速域名 https://api.tikhub.dev（直连免代理）；海外用 https://api.tikhub.io
AI_TRENDS_API_KEY=your_trends_api_key_here
AI_TRENDS_API_BASE=https://api.tikhub.dev

# ── 平台授权（阿里国际站开放 API，非 LLM；未授权时相关技能结构化降级）──
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=
ALIBABA_SESSION=

# ── 推送 Webhook（每日趋势推送；也可在前端「设置 → B端运营」填写）──
FEISHU_WEBHOOK_URL=
WECOM_WEBHOOK_URL=

# ── 本地服务 ──
FLOWMIND_MCP_URL=http://127.0.0.1:8001/mcp
FLOWMIND_MCP_HOST=127.0.0.1
FLOWMIND_MCP_PORT=8001
BROWSER_DEBUG_URL=http://127.0.0.1:9222
