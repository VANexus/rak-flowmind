# 阿里云万相API密钥（请去阿里云控制台获取后填写）
ALIYUN_API_KEY=your_api_key_here

# 阿里百炼（ASR: Paraformer 录音文件识别 / TTS+声音克隆: CosyVoice / OCR）
DASHSCOPE_API_KEY=your_dashscope_api_key_here
# LongCat 翻译（Anthropic 兼容协议 https://api.longcat.chat/anthropic）
LONGCAT_API_KEY=your_longcat_api_key_here

# TikHub 第三方数据 API（docs.tikhub.io；TikTok 热门标签榜等，替代自建爬虫）
# 获取：注册 tikhub.io → 用户中心创建 API Token；密钥只放本文件（.env 已 gitignored）
TIKHUB_API_KEY=your_tikhub_api_key_here
# 域名：大陆用加速域名 https://api.tikhub.dev（直连免代理）；海外用 https://api.tikhub.io
TIKHUB_API_BASE=https://api.tikhub.dev
