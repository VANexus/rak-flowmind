# ============================================================
# mcp-base-gpu 环境变量模板（复制到仓库根 .env 后填写；.env 已 gitignored）
#
# mcp-base-gpu：视频本地化 MCP over HTTP SaaS 服务端
#   - 云 key 域（LLM / 语音）沿用「功能域」前缀命名，与供应商解耦
#   - 基础设施（PG / MQTT / Milvus / 嵌入服务）FLOWMIND_* 前缀
# 配置源优先级（全仓库统一）：环境变量 → flowmind.config.toml [infra] → 内置默认
#   （本文件是 env 的模板；toml 兜底见 config.py InfraConfig）
# 密钥只放 .env，绝不进 toml / commit；本模板只允许占位符与注释示例。
# ============================================================

# ── LLM 域（字幕翻译；Anthropic 兼容协议）──
AI_LLM_PROTOCOL=anthropic
AI_LLM_API_KEY=your_llm_api_key_here
AI_LLM_BASE_URL=https://api.longcat.chat/anthropic
AI_LLM_MODEL=LongCat-2.0

# ── 语音域（云回落：ASR qwen-audio / OCR qwen3.5-ocr / TTS+声音复刻）──
AI_SPEECH_API_KEY=your_speech_api_key_here

# ── PostgreSQL（TaskStore 任务存储；经 PgBouncer 事务模式，短连接）──
# 集群内部（svc 短名示例）：postgres-rw.agentic.svc:5432 / pgbouncer.agentic.svc:6432
# 库名：mcp_base_gpu（业务用户无 CREATEDB，库由管理员预建；表由服务幂等自建）
FLOWMIND_PG_DSN=
# FLOWMIND_PG_DSN=postgresql://<user>:<password>@pgbouncer.agentic.svc:6432/mcp_base_gpu
FLOWMIND_PG_DB=mcp_base_gpu

# ── MQTT / EMQX（任务进度事件 mcp-base-gpu/tasks/{task_id}/events，终态 retain）──
# 集群内部（svc 短名示例）：emqx.agentic.svc:1883；两者都空 = 事件降级纯 PG 落库
FLOWMIND_MQTT_HOST=
FLOWMIND_MQTT_PORT=1883
FLOWMIND_MQTT_USE_TLS=0

# ── Milvus（字幕分段向量库 localize_segments，768 维）──
# 集群内部（svc 短名示例）：http://milvus.agentic.svc:19530
FLOWMIND_MILVUS_URI=

# ── BGE 嵌入服务（BAAI/bge-base-zh-v1.5；TEI /embed 与 OpenAI /v1/embeddings 双形状自适应）──
# 集群部署注入集群内服务地址；开发机联调默认 http://127.0.0.1:31997（本机同形状服务）
FLOWMIND_EMBEDDING_BASE_URL=

# ── 字幕向量化开关（localize_video 流水线尾部增值步骤；"0"/"false" 关闭）──
FLOWMIND_VECTORIZE=1

# ── 服务入口（单端口：MCP Streamable HTTP + 任务 REST 双通道）──
FLOWMIND_MCP_HOST=127.0.0.1
FLOWMIND_MCP_PORT=8001
# FLOWMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
