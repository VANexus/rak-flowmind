# ============================================================
# mcp-base-gpu 环境变量模板（复制到仓库根 .env 后填写；.env 已 gitignored）
#
# mcp-base-gpu：视频本地化 MCP over HTTP SaaS 服务端
#   - 云 key 域（LLM / 语音）沿用「功能域」前缀命名，与供应商解耦
#   - 基础设施（PG / MQTT / Milvus / 嵌入服务）FLOWMIND_* 前缀
# 配置源优先级（全仓库统一）：环境变量 → flowmind.config.toml [infra] → 内置默认
#   （本文件是 env 的模板；toml 兜底见 config.py InfraConfig）
# 密钥只放 .env，绝不进 toml / commit；本模板只允许占位符与注释示例。
# ============================================================

# ── LLM 域（字幕翻译；Anthropic 兼容协议）──
AI_LLM_PROTOCOL=anthropic
AI_LLM_API_KEY=your_llm_api_key_here
AI_LLM_BASE_URL=https://api.longcat.chat/anthropic
AI_LLM_MODEL=LongCat-2.0

# ── 语音域（云回落：ASR qwen-audio / OCR qwen3.5-ocr / TTS+声音复刻）──
AI_SPEECH_API_KEY=your_speech_api_key_here

# ── PostgreSQL（TaskStore 任务存储；经 PgBouncer 事务模式，短连接）──
# 统一库（ECO-ADR-0008/0013）：database=rak，schema=flowmind（ECO-ADR-0013 登记的 flowmind 域，
# 表由服务幂等自建）；登录角色 flowmind 由管理员预建（角色矩阵见 docs/unified-db-onboarding.md）
# 联邦注册表写 mcp.federation_backends（go-kernel 域，经同角色 mcp_app 成员身份授权）
FLOWMIND_PG_DSN=
# FLOWMIND_PG_DSN=postgresql://flowmind:<password>@pg-np.database.svc:5432/rak
FLOWMIND_PG_DB=rak

# ── MQTT / EMQX（任务进度事件 mcp-base-gpu/tasks/{task_id}/events，终态 retain）──
# 集群内部（svc 短名示例）：emqx.agentic.svc:1883；两者都空 = 事件降级纯 PG 落库
FLOWMIND_MQTT_HOST=
FLOWMIND_MQTT_PORT=1883
FLOWMIND_MQTT_USE_TLS=0
# 认证（可选）：EMQX 开启认证时取消注释并填写（占位符，换成真实凭证后只落 .env）；
# 两者为空 = 匿名连接
# FLOWMIND_MQTT_USERNAME=your_mqtt_username_here
# FLOWMIND_MQTT_PASSWORD=your_mqtt_password_here

# ── Milvus（字幕分段向量库 localize_segments，768 维）──
# 集群内部（svc 短名示例）：http://milvus.agentic.svc:19530；
# 未配置 = 向量化显式禁用（localize_video 静默跳过，localize_search 显式报错）
FLOWMIND_MILVUS_URI=

# ── BGE 嵌入服务（BAAI/bge-base-zh-v1.5；TEI /embed 与 OpenAI /v1/embeddings 双形状自适应）──
# 集群部署注入集群内服务地址；开发机联调可指向本机同形状服务（如 http://127.0.0.1:31997）；
# 未配置 = 嵌入显式禁用
FLOWMIND_EMBEDDING_BASE_URL=

# ── 字幕向量化开关（localize_video 流水线尾部增值步骤；"0"/"false" 关闭）──
# 注意：未配置 Milvus/嵌入服务时即使开关开启也会自动跳过（显式禁用态）
FLOWMIND_VECTORIZE=1

# ── 任务治理（LocalizerConfig；toml [localizer] 同名键可作兑底）──
# 任务工作目录基准（uploads / tasks / outputs 根目录；部署必配绝对路径）
# FLOWMIND_DATA_DIR=/srv/ws/flowmind-data
# 待处理任务上限（queued+running，超出 429 背压）
# FLOWMIND_MAX_PENDING_TASKS=100
# 终态任务 workdir/outputs 的保留时长 = GC 回收周期（默认 3600s，DB 行保留）
# FLOWMIND_TASK_TTL_SECONDS=3600

# ── 服务入口（单端口：MCP Streamable HTTP + 任务 REST 双通道）──
FLOWMIND_MCP_HOST=127.0.0.1
FLOWMIND_MCP_PORT=8002
# FLOWMIND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 本机媒体工具（ffmpeg / ffprobe：裁到镜头窗口、抽帧、提音轨都用它）──
# 默认按 PATH 找。本机 ffmpeg 常是「按需下载、不进全局 PATH」（ADR-080 的已知实况），故这里给一个
# bin 目录 ⇒ _media 会**优先**从它解析 ffmpeg/ffprobe 的**绝对路径**（不改系统 PATH、不动父进程环境）。
# 未配 ⇒ 原样按 PATH；仍找不到即如实报错（不静默换工具）。
# 例（正斜杠更省心，反斜杠亦可）：FLOWMIND_MEDIA_BIN_DIR=D:/App/ffmpeg/bin
# FLOWMIND_MEDIA_BIN_DIR=

# ── MCP 联邦网关自注册（federation 包；默认关）──
# 开启后进程经 MQTT + PG 双通道向网关联邦注册表声明自身并维持心跳，
# 优雅停机注销；未配置/不可达只记日志降级，绝不阻塞服务启动。
# 需 Go 网关 go-kernel（独立仓库）配合；键名与 config.py
# FederationBackendConfig 的 env 覆盖逐一对应。
# FLOWMIND_FEDERATION_REGISTER=0
# FLOWMIND_FEDERATION_BACKEND_ID=video_localizer
# FLOWMIND_FEDERATION_PREFIX=video_localizer
# FLOWMIND_FEDERATION_URL=            # 空=http://127.0.0.1:8002/mcp；集群填 http://<pod-ip>:8002/mcp
# FLOWMIND_FEDERATION_HEARTBEAT_INTERVAL=30

# ── 调用方凭证校验（ECO-ADR-0011 A 阶段）──
# 与 go-kernel 的 KERNEL_TRUSTED_SECRET **同值**：上游 → 网关 → 后端交换后的
# 下游 Bearer token 用同一 HMAC 格式（token 形状契约的真源在生态 ADR §4b）。
# 空 = 鉴权整体关闭（dev / 独立部署：现有 demo 与直连不受影响，任务不记租户）。
# 非空后：除 /api/v1/health 与 /api/v1/manifest 外所有请求必须带 Bearer，
# 且任务读写变 fail-closed（无凭证 = 看不到任何任务，而不是看到全部）。
# FLOWMIND_AUTH_SECRET=

# ── dsp 成片技能族（独立 backend，prefix=dsp；契约见 cross-dashboard 的
#    docs/architecture/2026-10-11-dsp-backend-skill-contract.md）──
# 族筛选：只注册哪些族的技能；缺省（不设）= 全部族。dsp 以独立进程/部署
# 注册为 prefix=dsp 的 backend，注册表里只应有 dsp 七项（契约 §6）。
# FLOWMIND_SKILL_FAMILIES=dsp
# FLOWMIND_MCP_PORT=8003
# FLOWMIND_FEDERATION_REGISTER=1
# FLOWMIND_FEDERATION_BACKEND_ID=dsp
# FLOWMIND_FEDERATION_PREFIX=dsp

# 对象存储（S3/MinIO 兼容；dsp 产物落云存储 prefix，回传 key 需被前端按租户段取到）
# FLOWMIND_DSP_S3_ENDPOINT=127.0.0.1:9000
# FLOWMIND_DSP_S3_BUCKET=flowmind
# FLOWMIND_DSP_S3_REGION=
# FLOWMIND_DSP_S3_SECURE=0            # MinIO 明文设 0
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# **公网**对象存储端点（图生视频参考素材，ADR-123）
# 内部端点只给本仓读写；给外部厂商的预签名 URL 必须由**公网端点**签发
#（SigV4 把 Host 签进 URL，签完改 hostname 会 403）。
# 未配置时：内部端点**字面公网**才沿用它；本机 / 内网端点一律视为「没有公网入口」
#（图生视频逐镜跳过并回落静图，步骤标 degraded，不假装成功）。
# 须与 cross-dashboard 的 S3_PUBLIC_ENDPOINT 同址。
# FLOWMIND_DSP_S3_PUBLIC_ENDPOINT=https://s3.example.com
# FLOWMIND_DSP_S3_PUBLIC_SECURE=1     # 端点只写 host:port 时用；带 scheme 时忽略
# FLOWMIND_DSP_S3_PUBLIC_ADDRESSING_STYLE=path   # 自建 MinIO 反代通常 path；虚拟主机风格设 virtual

# 提交厂商前的公网 HTTP 预检（ADR-123；0 关 = 只做字面主机判定）
# FLOWMIND_DSP_VIDEOGEN_PUBLIC_PROBE=1

# 火山 AI MediaKit（render_compose 的实现落点；密钥只在本后端，集群 Secret）
# DSP_MEDIAKIT_API_KEY=
# FLOWMIND_DSP_MEDIAKIT_QUEUE_ID=
# 火山豆包语音「音频生成」（tts_generate；新版控制台 X-Api-Key 单头）
# DSP_TTS_API_KEY=
# 配音音色 id（属 L1 人工确认项；缺省则用模型默认音色。示例）
# FLOWMIND_DSP_TTS_SPEAKER=zh_male_liufei_uranus_bigtts
# 时间线对齐（timeline_build）：无口播镜的展示时长（ms）
# **显式常量、非实测**——`_dsp_align` 只在「停顿/尾部静默不够」时用它，并在 warnings 里如实标注
# FLOWMIND_DSP_TIMELINE_SILENT_SHOT_MS=1500

# 切镜节奏收口（timeline_build，ADR-070）：过短的镜并入相邻镜 / 过长的镜在其内部句边界一分为二
# 与 cross-dashboard 的 lib/content/dsp-cut.ts **同值**（改口径两边一起改）
# FLOWMIND_DSP_TIMELINE_SHOT_MIN_MS=1500
# FLOWMIND_DSP_TIMELINE_SHOT_MAX_MS=6000
# 收口后镜头数的合法区间（越界只告警不夹取）
# FLOWMIND_DSP_TIMELINE_SHOT_LIMIT_MIN=2
# FLOWMIND_DSP_TIMELINE_SHOT_LIMIT_MAX=10

# 图生视频（image_to_video；**独立第三方** api.chenxingai.vip，非火山）
# Authorization: Bearer sk-…（密钥只在后端）
# DSP_VIDEOGEN_API_KEY=
# 非密钥可调项（缺省即下方内置默认）
# FLOWMIND_DSP_VIDEOGEN_MODEL=seedance-2.5-global-sp
# FLOWMIND_DSP_VIDEOGEN_ASPECT_RATIO=9:16
# FLOWMIND_DSP_VIDEOGEN_SIZE=720x1280
# FLOWMIND_DSP_VIDEOGEN_QUALITY=standard
