      },
      "models": {
        "Evidence": {
          "fields": {
            "comparison": "<class 'str'>",
            "metric": "<class 'str'>",
            "threshold": "float | str | None",
            "value": "float | str",
            "window": "str | None"
          },
          "locator": "src/flowmind/contracts.py#Evidence",
          "required": [
            "comparison",
            "metric",
            "value"
          ]
        },
        "ReasoningChain": {
          "fields": {
            "causal_analysis": "<class 'str'>",
            "conclusion": "<class 'str'>",
            "confidence": "<class 'float'>",
            "evidence": "list[flowmind.contracts.Evidence]",
            "risk_note": "<class 'str'>",
            "triggered_rules": "list[flowmind.contracts.RuleHit]"
          },
          "locator": "src/flowmind/contracts.py#ReasoningChain",
          "required": [
            "causal_analysis",
            "conclusion",
            "risk_note"
          ]
        },
        "ReliabilityMetrics": {
          "fields": {
            "confidence": "<class 'float'>",
            "degradation_reason": "str | None",
            "degraded": "<class 'bool'>",
            "latency_ms": "<class 'float'>",
            "sample_size": "<class 'int'>"
          },
          "locator": "src/flowmind/contracts.py#ReliabilityMetrics",
          "required": [
            "confidence",
            "latency_ms",
            "sample_size"
          ]
        },
        "RuleHit": {
          "fields": {
            "expression": "<class 'str'>",
            "hit": "<class 'bool'>",
            "name": "<class 'str'>",
            "rule_id": "<class 'str'>"
          },
          "locator": "src/flowmind/contracts.py#RuleHit",
          "required": [
            "expression",
            "hit",
            "name",
            "rule_id"
          ]
        },
        "SkillError": {
          "fields": {
            "code": "<class 'str'>",
            "details": "dict | None",
            "message": "<class 'str'>",
            "retriable": "<class 'bool'>"
          },
          "locator": "src/flowmind/contracts.py#SkillError",
          "required": [
            "code",
            "message"
          ]
        },
        "SkillOutput": {
          "fields": {
            "confidence": "<class 'float'>",
            "data": "~T",
            "degradation_reason": "str | None",
            "degraded": "<class 'bool'>",
            "reasoning": "list[flowmind.contracts.ReasoningChain]",
            "sample_size": "<class 'int'>"
          },
          "locator": "src/flowmind/contracts.py#SkillOutput",
          "required": [
            "data"
          ]
        },
        "SkillResult": {
          "fields": {
            "data": "Optional[~T]",
            "error": "flowmind.contracts.SkillError | None",
            "metrics": "<class 'flowmind.contracts.ReliabilityMetrics'>",
            "ok": "<class 'bool'>",
