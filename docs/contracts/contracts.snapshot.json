    "INV3_rest_tasks_contract": {
      "health": {
        "always_200": true,
        "components": [
          "pg",
          "mqtt",
          "milvus"
        ],
        "keys": [
          "components",
          "skill_count",
          "status",
          "version"
        ],
        "locator": "src/flowmind/server_tasks.py#health",
        "status_values": [
          "ok",
          "degraded"
        ]
      },
      "locator": "src/flowmind/server_tasks.py + src/flowmind/server_rest.py",
      "polling": {
        "args_opt_in": "GET /api/v1/tasks/{id}?include=args",
        "locator": "src/flowmind/server_tasks.py#task_get + tasks/store.py#_row_to_dict",
        "row_keys": [
          "created_at",
          "error",
          "finished_at",
          "output_paths",
          "progress",
          "skill_id",
          "stage",
          "started_at",
          "status",
          "steps",
          "task_id",
          "tenant_id"
        ]
      },
      "routes": [
        {
          "error_codes": [
            "invalid_json",
            "queue_full",
            "steps_invalid",
            "unknown_skill",
            "validation"
          ],
          "methods": [
            "POST"
          ],
          "path": "/api/v1/tasks",
          "source": "src/flowmind/server_tasks.py",
          "status_codes": [
            202,
            400,
            404,
            422,
            429
          ]
        },
        {
          "error_codes": [
            "unknown_task"
          ],
          "methods": [
            "GET"
          ],
          "path": "/api/v1/tasks/{task_id}",
          "source": "src/flowmind/server_tasks.py",
          "status_codes": [
            404
          ]
        },
