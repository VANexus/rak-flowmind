# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# 参赛材料（大体积二进制，不入库）
*.docx
.~*.docx

# 用户本地配置（由 agent 初始化对话生成，不入库）
flowmind.config.toml

# subagent-driven-development 脚手架（本地过程产物，不入库）
.superpowers/

# flowmind-test-skill 的运行产物（本地测试报告，不入库）
.test-runs/

# 环境变量（真实密钥，绝不入库）
.env
# 切换存储 / 端点前留的 env 备份（同样含真实密钥，绝不入库）
.env.bak-*

# 生成的测试图片
out/
._lv_work/

# 本地视频测试素材与流水线产物（大体积二进制，不入库）
/*.mp4
*.bak

# local debug artifacts
cc_debug.png
*.png.tmp
.codegraph/
.claude/worktrees/
.claude/

# 旧 CDP 抓取方案的浏览器配置目录（方案已删除，本地残留不入库）
.browser-profile/

# TikHub response disk cache (runtime artifact, not committed)
.cache/

# Go 联邦网关（独立 git 仓库 VANexus/go-kernel：单独 clone 到仓库根旁才可达，不随本仓库入库）
go-kernel/

# Trae IDE 本地过程产物
.trae/

# 厂商 PDF（大体积二进制，不入库）；分类对照表 docs/vendor/README.md 入库
docs/vendor/*.pdf
